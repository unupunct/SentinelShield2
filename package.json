{
  "name": "sentinel-shield",
  "version": "0.1.0",
  "private": true,
  "description": "Extensie Chrome (Manifest V3) pentru protecție împotriva site-urilor malițioase, cu analiză explicabilă a riscurilor.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "validate": "node scripts/validate-manifest.mjs",
    "test": "vitest run",
    "build:zip": "node scripts/build-zip.mjs",
    "audit:code": "node scripts/validate-manifest.mjs",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "check": "npm run validate && npm test"
  },
  "devDependencies": {
    "puppeteer-core": "^25.14.0",
    "vitest": "^3.2.4"
  }
}