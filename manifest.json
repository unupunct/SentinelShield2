{
  "manifest_version": 3,
  "name": "SentinelShield2",
  "version": "0.1.0",
  "version_name": "0.1.0 (MVP)",
  "description": "Analiză locală, explicabilă, a linkurilor și a paginilor, pentru a recunoaște indiciile de phishing. Fără cont, fără colectare implicită de date.",
  "author": "SentinelShield2",
  "minimum_chrome_version": "110",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],

  "optional_permissions": [
    "webNavigation"
  ],

  "optional_host_permissions": [
    "*://*/*"
  ],

  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },

  "action": {
    "default_title": "SentinelShield2 - analizează pagina sau un link",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
