{
  "manifest_version": 3,
  "name": "Sentinel Shield",
  "version": "0.1.0",
  "description": "Protecție împotriva phishingului și a site-urilor malițioase, cu analiză explicabilă a riscurilor. Procesare locală implicită.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Sentinel Shield",
    "default_popup": "src/pages/popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "src/pages/dashboard/dashboard.html", "open_in_tab": true },
  "background": { "service_worker": "src/background/service-worker.js", "type": "module" },
  "permissions": ["storage", "webNavigation", "downloads", "alarms", "activeTab"],
  "optional_permissions": ["declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": [
    "<all_urls>",
    "https://urlhaus-api.abuse.ch/*",
    "https://safebrowsing.googleapis.com/*",
    "https://urlhaus.abuse.ch/*",
    "https://openphish.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/pages/warning/warning.html", "src/pages/warning/warning.js", "src/pages/warning/warning.css", "src/shared/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
